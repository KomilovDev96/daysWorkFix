# ─────────────────────────────────────────────
#  ОБЯЗАТЕЛЬНЫЕ
# ─────────────────────────────────────────────

# Длинная случайная строка для подписи JWT-токенов
# Сгенерировать: openssl rand -hex 64
JWT_SECRET=

# Токен Telegram-бота из @BotFather
TELEGRAM_BOT_TOKEN=

# ─────────────────────────────────────────────
#  PROD-ДОМЕН
# ─────────────────────────────────────────────

# Полный адрес сайта. Если указать https://домен — Caddy сам выпустит SSL.
#   - HTTP без домена (для теста):  SITE_ADDRESS=:80
#   - С доменом и авто-SSL:         SITE_ADDRESS=https://myapp.example.com
SITE_ADDRESS=:80

# Email для уведомлений Let's Encrypt (используется только при https)
ACME_EMAIL=admin@example.com

# ─────────────────────────────────────────────
#  ОПЦИОНАЛЬНЫЕ
# ─────────────────────────────────────────────

# Модель Ollama. При первом запуске будет скачана автоматически.
# Альтернативы: qwen2.5:7b (лучше качество, ~5GB), llama3.1:8b (~5GB)
OLLAMA_MODEL=qwen2.5:3b

# Время жизни JWT-токена
JWT_EXPIRES_IN=30d
